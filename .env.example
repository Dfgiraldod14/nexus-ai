# ──────────────────────────────────────────────────────────────
# PayPal Nexus AI · environment
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────

# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
NODE_ENV=development

# PayPal Developer (Sandbox) — https://developer.paypal.com/dashboard/applications/sandbox
# Without these two values the app runs in DEMO mode with a simulated checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# Your trading bot / Streamlit engine
BOT_URL=http://150.136.227.127:8501
# Comma-separated JSON endpoints probed (in order) for strategy telemetry
BOT_STRATEGY_PATH=/nexus/strategy,/api/strategy,/strategy,/.well-known/nexus.json
# Optional shared secret sent as X-API-Key to the bot
BOT_API_KEY=
BOT_TIMEOUT_MS=3500
BOT_CACHE_MS=15000

# Force the deterministic simulator even if the bot is online (useful for CI)
NEXUS_OFFLINE=0

# Fee benchmark used to calculate the savings (traditional cross-border route)
CROSS_BORDER_FEE_PCT=4.99
FX_SPREAD_PCT=4.00

# Limits
MIN_TRANSFER_AMOUNT=1
MAX_TRANSFER_AMOUNT=25000

# Quote signing secret (set a long random value in production!)
QUOTE_SECRET=change-me-to-a-long-random-string

# Persistence: a JSON ledger. On serverless platforms use /tmp (ephemeral).
DATA_DIR=./data
SEED_DEMO=1

# Optional comma-separated list of allowed browser origins for the API
ALLOWED_ORIGINS=
